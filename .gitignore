# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# OMC operational state (see CLAUDE.md); .omc/skills/ is the committable exception
.omc/*
!.omc/skills/

# Build and kernel artifacts -- hsa/gfx90a is GENERATED by
# configs/repatch_gfx942_to_gfx90a.py and must never be committed by hand
*.co
*.so
*.o
build/

# GPU core dumps. ROCm writes a full HBM snapshot (~60 GB each) on an
# unhandled GPU exception; set HSA_DISABLE_COREDUMP_ON_EXCEPTION=1 to stop it.
gpucore.*.gpu
core.*

# Local scratch
*.log
*.tmp
