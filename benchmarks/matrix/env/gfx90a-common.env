# Environment for every MI210 (gfx90a / CDNA2) benchmark run in this matrix.
#
#   source benchmarks/matrix/env/gfx90a-common.env
#
# Each entry carries a verdict from the July 2026 revalidation in
# benchmarks/matrix/research/raw-tuning-knobs-opencode.md, which cites the
# source file and line for every claim. The point of writing verdicts down is
# that roughly half the "well-known" ROCm tuning knobs do NOTHING on this
# card -- they are CDNA3 features, or they were deleted from the upstream
# project -- and setting them anyway creates a false sense of having tuned.
#
# Verdicts: WORKS / MI300-ONLY / REMOVED / NO-EFFECT / HARMFUL

# ---------------------------------------------------------------- WORKS ---

# REQUIRED on MI200-series. AMD's own RCCL documentation calls out a 5-10x
# latency improvement from not reclaiming scratch between dispatches. This is
# the single highest-value knob on this hardware and it is NOT the default.
export HSA_NO_SCRATCH_RECLAIM=1

# CORRECTED 2026-07-31, and the default is now 0. This previously read
# "MANDATORY on this box specifically: the two MI210s have NO xGMI bridge and
# cannot peer-to-peer". The first half is true. The second does not follow from
# it, and it is false. Found by outside review from
# https://github.com/Andrei-Dr (PR #35).
#
# The driver advertises an enabled PCIe P2P link --
# /sys/class/kfd/kfd/topology/nodes/{1,2}/p2p_links/0/properties gives type 2
# (HSA_IOLINKTYPE_PCIEXPRESS; XGMI would be 11), max_bandwidth 32000 MB/s,
# flags 3. Per hsakmttypes.h:504-511 that is Override + NonCoherent, so bit 4
# NoPeerToPeerDMA is CLEAR. Measured on this box (benchmarks/matrix/p2p_bw.py):
#
#   can_device_access_peer(0,1) = True   cuda:0 -> cuda:1   26.98 GB/s
#   via pinned host memory, 2 hops                          14.16 GB/s
#
# and the A/B that follows from it (round31_p2p_ab.sh, 3 reps per arm,
# Qwen3-30B-A3B W8A8 at TP=2), P2P disabled -> enabled:
#
#   cold 16k prefill   7,279.2 -> 8,093.0 t/s   +11.2%
#   cold 16k TTFT        2.085 ->   1.869 s     -10.3%
#   longctx prefill    6,190.8 -> 6,760.7 t/s    +9.2%
#   longctx TTFT         4.162 ->   3.811 s      -8.4%
#   longctx decode       54.06 ->   54.76 t/s    +1.3%  (noise)
#
# Prefill gains and decode does not, which is the expected shape: prefill
# allreduces move large activation tensors and are bandwidth-bound, decode
# allreduces move small buffers and are latency-bound.
#
# ON THE STALL THIS FLAG WAS ADDED FOR. It was real and is still unexplained --
# neither the driver reading nor the bandwidth measurement accounts for it. It
# did NOT recur across the four TP=2 collective setups run while establishing
# the above. That is evidence, not proof. If a multi-GPU run hangs during
# collective setup, set this back to 1 and say so in the run label:
#
#   NCCL_P2P_DISABLE=1 ./bin/round<N>.sh
export NCCL_P2P_DISABLE="${NCCL_P2P_DISABLE:-0}"

# Number of hardware queues the HIP runtime will use. Default is 4 in
# ROCm/clr. Stated explicitly so the value is recorded in the repro guide
# rather than inherited silently and forgotten.
export GPU_MAX_HW_QUEUES=4

# ------------------------------------------------------ NOT SET, and why ---

# HIP_FORCE_DEV_KERNARG -- NO-EFFECT on gfx90a.
#   Already defaults to 1 in ROCm/clr (rocclr/utils/flags.hpp), and the
#   auto-enable path is gated on isGfx94x, i.e. CDNA3. The underlying device
#   kernarg feature is CDNA3+. Setting it on an MI210 changes nothing.
#
# VLLM_USE_TRITON_FLASH_ATTN -- REMOVED from current vLLM.
#   No longer present in vllm/envs.py; attention backend selection became
#   automatic. Setting it is a no-op that reads like configuration.
#
# VLLM_USE_V1 -- REMOVED. V1 is the only architecture in current vLLM.
#
# VLLM_ROCM_USE_AITER* (all sub-flags) -- NO-EFFECT on stock vLLM.
#   The master gate is is_aiter_found_and_supported() -> on_mi3xx(), and
#   _ON_MI3XX resolves to gfx942|gfx950. gfx90a is excluded, so every AITER
#   sub-flag is dead on this card *unless* vLLM is patched.
#   THIS REPO PATCHES IT: configs/enable_vllm_aiter_gfx90a.py narrows the gate
#   so attention (and only attention) can reach AITER on gfx90a. Runs that
#   apply that patch set the flags below; runs that do not, must not.
#
# Quick Reduce / AITER_QUICK_REDUCE_QUANTIZATION -- MI300-ONLY.
#   quick_all_reduce.py checks for ["gfx94", "gfx95"] and explicitly rejects
#   gfx90a. It also presumes xGMI, which this box does not have. Two
#   independent reasons it cannot apply here.

# ------------------------------------------- AITER, only when patched in ---
# Leave commented for stock-vLLM arms. Uncomment ONLY for arms where
# configs/enable_vllm_aiter_gfx90a.py has been applied, and say so in the run
# label -- otherwise the A and B arms are not comparable.
#
# export VLLM_ROCM_USE_AITER=1
# export VLLM_ROCM_USE_AITER_MHA=1

# Set to info to have AITER print which code object each ASM call loads. This
# is the only way to prove an ASM kernel was actually used rather than a
# silent fallback to CK or Triton -- docs 16 and 17 published fallback numbers
# as ASM results precisely because nobody checked.
export AITER_LOG_LEVEL=warning

# ------------------------------------------------------------- ccache ------
# Shared host cache; see guides/setup-ccache-docker.md. CCACHE_DEPEND=1 is the
# setting that matters, because preprocessor-mode hashing on Composable Kernel
# header trees costs a large fraction of the compile it is trying to avoid.
export CCACHE_DIR=/ccache
export CCACHE_MAXSIZE=100G
export CCACHE_DEPEND=1
export CCACHE_SLOPPINESS=locale,time_macros,include_file_ctime,include_file_mtime

# --------------------------------------------------------- determinism -----
# Benchmarks pass an explicit seed per request; this covers library-side RNG.
export PYTHONHASHSEED=0

# ---------------------------------------------------- device index trap -----
# On this host the HIP and rocm-smi device orderings are REVERSED:
#
#   rocm-smi GPU[0] = PCIe 87:00.0 = HIP_VISIBLE_DEVICES=1
#   rocm-smi GPU[1] = PCIe C3:00.0 = HIP_VISIBLE_DEVICES=0
#
# rocm-smi enumerates by bus order; HIP enumerates by its own agent order.
# Reading rocm-smi to find an idle card and then pinning HIP_VISIBLE_DEVICES to
# that same number lands on the WRONG card. Always confirm with rocminfo BDFID
# rather than assuming the indices agree.
